generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlserver"
  url      = env("DATABASE_URL")
}

//////////////////////
// AUTH / SECURITY //
//////////////////////

model User {
  id           Int       @id @default(autoincrement())
  username     String    @unique
  matricule    String?
  email        String?
  firstName    String?
  lastName     String?
  passwordHash String
  isActive     Boolean   @default(true)
  createdAt    DateTime  @default(now())
  deletedAt    DateTime? // âœ… AJOUT ICI
  updatedAt    DateTime  @updatedAt

  // ðŸ” APPARTENANCE MÃ‰TIER
  siteId Int?
  site   Site? @relation("UserSite", fields: [siteId], references: [id])

  roles         UserRole[]
  refreshTokens RefreshToken[]

  categories  Category[]
  processes   Process[]
  tasks       Task[]
  subCategory SubCategory[]
  subProcess  SubProcess[]

  createdIncidents  Incident[]        @relation("IncidentCreator")
  reportedIncidents Incident[]        @relation("IncidentReporter")
  // âœ… renommÃ©
  typesCreated      Type[]            @relation("TypeCreatedBy")
  incidentComments  IncidentComment[]

  // ðŸ”¹ Sites crÃ©Ã©s (optionnel mais propre)
  createdSites Site[] @relation("SiteCreator")

  // Reset password
  resetPasswordToken   String?
  resetPasswordExpires DateTime?
}

model Role {
  id   Int    @id @default(autoincrement())
  name String @unique

  users       UserRole[]
  permissions RolePermission[]
}

model Permission {
  id   Int    @id @default(autoincrement())
  code String @unique

  roles RolePermission[]
}

model UserRole {
  userId Int
  roleId Int

  user User @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@id([userId, roleId])
}

model RolePermission {
  roleId       Int
  permissionId Int

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@id([roleId, permissionId])
}

model RefreshToken {
  id        Int      @id @default(autoincrement())
  tokenHash String   @unique
  userId    Int
  expiresAt DateTime
  revoked   Boolean  @default(false)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([userId])
}

//////////////
// DOMAIN  //
//////////////

model Site {
  id   Int    @id @default(autoincrement())
  name String

  createdByUserId Int
  createdBy       User  @relation("SiteCreator", fields: [createdByUserId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  // âœ… Site prend l'ID de type
  typeId          Int?
  type            Type? @relation(fields: [typeId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  // ðŸ”¹ Utilisateurs appartenant au site
  users User[] @relation("UserSite")

  incidentSites     IncidentSite[]
  impactedIncidents IncidentImpactedSite[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([typeId])
}

model Type {
  id              Int       @id @default(autoincrement())
  name            String
  createdByUserId Int
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  deletedAt       DateTime?

  createdBy User @relation("TypeCreatedBy", fields: [createdByUserId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  // âœ… back relation
  sites Site[]
}

model Category {
  id   Int    @id @default(autoincrement())
  name String

  userId Int
  user   User @relation(fields: [userId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  subCategories SubCategory[]
  incidents     Incident[] // âœ… AJOUT ICI

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?
}

model SubCategory {
  id          Int     @id @default(autoincrement())
  name        String
  description String?

  categoryId Int
  category   Category @relation(fields: [categoryId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  userId     Int
  user       User     @relation(fields: [userId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  incidents Incident[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([categoryId])
}

model Process {
  id   Int    @id @default(autoincrement())
  name String

  userId Int
  user   User @relation(fields: [userId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  subProcesses SubProcess[]
  incidents    Incident[] // âœ… AJOUT ICI

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?
}

model SubProcess {
  id          Int     @id @default(autoincrement())
  name        String
  description String?

  processId Int
  process   Process @relation(fields: [processId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  userId    Int
  user      User    @relation(fields: [userId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  incidents Incident[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([processId])
}

model Incident {
  id               Int      @id @default(autoincrement())
  reference        String   @unique
  description      String
  scope            String
  status           String   @default("OPEN")
  urgency          String
  criticality      String
  otherSubCategory String?
  reporterName     String // âœ… nouveau : nom du dÃ©clarant (mÃ©tier)
  glpiTicketId     Int?
  dueDate          DateTime

  userId Int
  user   User @relation("IncidentCreator", fields: [userId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  reporterId Int
  reporter   User @relation("IncidentReporter", fields: [reporterId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  subProcessId Int?
  subProcess   SubProcess? @relation(fields: [subProcessId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  categoryId Int
  category   Category @relation(fields: [categoryId], references: [id])

  subCategoryId Int?
  subCategory   SubCategory? @relation(fields: [subCategoryId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  processDomainId Int?
  processDomain   Process? @relation(fields: [processDomainId], references: [id])

  tasks                 Task[]
  incidentSites         IncidentSite[]
  incidentImpactedSites IncidentImpactedSite[] // âœ… OBLIGATOIRE
  incidentPersonnes     IncidentPersonne[]
  attachments           Attachment[]
  comments              IncidentComment[] // âœ… liste des commentaires

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([userId])
  @@index([reporterId])
  @@index([categoryId])
  @@index([subProcessId])
  @@index([subCategoryId])
  @@index([processDomainId])
}

model IncidentComment {
  id         Int      @id @default(autoincrement())
  incidentId Int
  incident   Incident @relation(fields: [incidentId], references: [id], onDelete: Cascade)

  userId Int
  user   User @relation(fields: [userId], references: [id])

  content   String
  createdAt DateTime @default(now())
}

model Personne {
  id       Int    @id @default(autoincrement())
  fullname String @unique

  incidents IncidentPersonne[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([fullname])
}

model Task {
  id          Int       @id @default(autoincrement())
  name        String
  description String?
  status      String    @default("OPEN")
  dueDate     DateTime?
  userId      Int
  user        User      @relation(fields: [userId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  incidentId Int
  incident   Incident @relation(fields: [incidentId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  attachments Attachment[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([userId])
  @@index([incidentId])
}

model Attachment {
  id       Int    @id @default(autoincrement())
  fileName String
  url      String

  incidentId Int?
  incident   Incident? @relation(fields: [incidentId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  taskId Int?
  task   Task? @relation(fields: [taskId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  uploadedAt DateTime @default(now())

  @@index([incidentId])
  @@index([taskId])
}

model IncidentSite {
  incidentId Int
  siteId     Int

  incident Incident @relation(fields: [incidentId], references: [id], onDelete: Cascade)
  site     Site     @relation(fields: [siteId], references: [id], onDelete: Cascade)

  @@id([incidentId, siteId])
}

model IncidentImpactedSite {
  incidentId Int
  siteId     Int

  incident Incident @relation(fields: [incidentId], references: [id], onDelete: Cascade)
  site     Site     @relation(fields: [siteId], references: [id], onDelete: Cascade)

  @@id([incidentId, siteId])
}

model IncidentPersonne {
  incidentId Int
  personneId Int

  incident Incident @relation(fields: [incidentId], references: [id], onDelete: Cascade)
  personne Personne @relation(fields: [personneId], references: [id], onDelete: Cascade)

  assignedAt DateTime @default(now()) // optionnel mais recommandÃ©

  @@id([incidentId, personneId]) // clÃ© primaire composite
  @@index([personneId])
}


