generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlserver"
  url      = env("DATABASE_URL")
}

//////////////////////
// AUTH / SECURITY //
//////////////////////

model User {
  id             Int      @id @default(autoincrement())
  username       String   @unique
  passwordHash   String
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  deletedAt      DateTime? // ✅ AJOUT ICI
  roles          UserRole[]
  refreshTokens  RefreshToken[]

  sites          Site[]
  categories     Category[]
  processes      Process[]
  tasks          Task[]
  subCategory    SubCategory[]
  subProcess     SubProcess[]
  createdIncidents  Incident[] @relation("IncidentCreator")
  reportedIncidents Incident[] @relation("IncidentReporter")
  assignedIncidents IncidentUser[]
}

model Role {
  id    Int    @id @default(autoincrement())
  name  String @unique

  users       UserRole[]
  permissions RolePermission[]
}

model Permission {
  id   Int    @id @default(autoincrement())
  code String @unique

  roles RolePermission[]
}

model UserRole {
  userId Int
  roleId Int

  user User @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@id([userId, roleId])
}

model RolePermission {
  roleId       Int
  permissionId Int

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@id([roleId, permissionId])
}

model RefreshToken {
  id        Int      @id @default(autoincrement())
  tokenHash String   @unique
  userId    Int
  expiresAt DateTime
  revoked   Boolean  @default(false)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([userId])
}

//////////////
// DOMAIN  //
//////////////

model Site {
  id        Int   @id @default(autoincrement())
  name      String

  userId    Int
  user      User @relation(fields: [userId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  incidentSites IncidentSite[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  deletedAt DateTime?
}

model Category {
  id        Int   @id @default(autoincrement())
  name      String

  userId    Int
  user      User @relation(fields: [userId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  subCategories SubCategory[]
  incidents     Incident[]   // ✅ AJOUT ICI

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  deletedAt DateTime?
}

model SubCategory {
  id          Int   @id @default(autoincrement())
  name        String
  description String?

  categoryId  Int 
  category    Category @relation(fields: [categoryId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  userId    Int
  user      User @relation(fields: [userId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  incidents Incident[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  deletedAt DateTime?

  @@index([categoryId])
}

model Process {
  id        Int   @id @default(autoincrement())
  name      String

  userId    Int
  user      User @relation(fields: [userId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  subProcesses SubProcess[]
  incidents    Incident[]   // ✅ AJOUT ICI

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  deletedAt DateTime?
}

model SubProcess {
  id          Int   @id @default(autoincrement())
  name        String
  description String?

  processId   Int 
  process     Process @relation(fields: [processId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  userId    Int
  user      User @relation(fields: [userId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  incidents Incident[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  deletedAt DateTime?

  @@index([processId])
}

model Incident {
  id            Int   @id @default(autoincrement())
  description   String
  scope         String
  status        String   @default("OPEN")
  urgency       String
  criticality   String
  otherSubCategory String?

  dueDate         DateTime

  userId        Int
  user          User @relation("IncidentCreator", fields: [userId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  reporterId    Int
  reporter      User @relation("IncidentReporter", fields: [reporterId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  subProcessId  Int
  subProcess    SubProcess @relation(fields: [subProcessId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  categoryId      Int
  category        Category  @relation(fields: [categoryId], references: [id])

  subCategoryId Int
  subCategory   SubCategory @relation(fields: [subCategoryId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  processDomainId Int?
  processDomain   Process?  @relation(fields: [processDomainId], references: [id])

  tasks         Task[]
  incidentSites   IncidentSite[]
  incidentUsers   IncidentUser[]
  attachments   Attachment[]

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  deletedAt     DateTime?

  @@index([userId])
  @@index([reporterId])
  @@index([categoryId])
  @@index([subProcessId])
  @@index([subCategoryId])
  @@index([processDomainId])
}

model Task {
  id          Int   @id @default(autoincrement())
  name        String
  description String?

  userId      Int
  user        User @relation(fields: [userId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  incidentId  Int
  incident    Incident @relation(fields: [incidentId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  attachments Attachment[]

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  deletedAt   DateTime?

  @@index([userId])
  @@index([incidentId])
}


model Attachment {
  id         Int   @id @default(autoincrement())
  fileName   String
  mimeType   String
  size       Int
  url        String

  incidentId Int?
  incident   Incident? @relation(fields: [incidentId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  taskId     Int?
  task       Task? @relation(fields: [taskId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  uploadedAt DateTime @default(now())

  @@index([incidentId])
  @@index([taskId])
}

model IncidentSite {
  incidentId Int
  siteId     Int

  incident   Incident @relation(fields: [incidentId], references: [id])
  site       Site     @relation(fields: [siteId], references: [id])

  @@id([incidentId, siteId])
}

model IncidentUser {
  incidentId Int
  userId     Int

  incident   Incident @relation(fields: [incidentId], references: [id])
  user       User     @relation(fields: [userId], references: [id])

  @@id([incidentId, userId])
}
