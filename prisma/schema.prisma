generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlserver"
  url      = env("DATABASE_URL")
}

//////////////////////
// AUTH / SECURITY //
//////////////////////

model User {
  id             Int      @id @default(autoincrement())
  username       String   @unique
  passwordHash   String
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())

  roles          UserRole[]
  refreshTokens  RefreshToken[]

  sites          Site[]
  categories     Category[]
  processes      Process[]
  tasks          Task[]

  createdIncidents  Incident[] @relation("IncidentCreator")
  reportedIncidents Incident[] @relation("IncidentReporter")
  assignedIncidents Incident[] @relation("IncidentAssignedUsers")
}

model Role {
  id    Int    @id @default(autoincrement())
  name  String @unique

  users       UserRole[]
  permissions RolePermission[]
}

model Permission {
  id   Int    @id @default(autoincrement())
  code String @unique

  roles RolePermission[]
}

model UserRole {
  userId Int
  roleId Int

  user User @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@id([userId, roleId])
}

model RolePermission {
  roleId       Int
  permissionId Int

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@id([roleId, permissionId])
}

model RefreshToken {
  id        Int      @id @default(autoincrement())
  tokenHash String   @unique
  userId    Int
  expiresAt DateTime
  revoked   Boolean  @default(false)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([userId])
}

//////////////
// DOMAIN  //
//////////////

model Site {
  id        String   @id @default(uuid())
  name      String

  userId    Int
  user      User @relation(fields: [userId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  incidents Incident[] @relation("IncidentSites")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  deletedAt DateTime?
}

model Category {
  id        String   @id @default(uuid())
  name      String

  userId    Int
  user      User @relation(fields: [userId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  subCategories SubCategory[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  deletedAt DateTime?
}

model SubCategory {
  id          String   @id @default(uuid())
  name        String
  description String?

  categoryId  String
  category    Category @relation(fields: [categoryId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  incidents Incident[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  deletedAt DateTime?

  @@index([categoryId])
}

model Process {
  id        String   @id @default(uuid())
  name      String

  userId    Int
  user      User @relation(fields: [userId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  subProcesses SubProcess[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  deletedAt DateTime?
}

model SubProcess {
  id          String   @id @default(uuid())
  name        String
  description String?

  processId   String
  process     Process @relation(fields: [processId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  incidents Incident[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  deletedAt DateTime?

  @@index([processId])
}

model Incident {
  id            String   @id @default(uuid())
  title         String
  description   String?
  status        String   @default("OPEN")

  userId        Int
  user          User @relation("IncidentCreator", fields: [userId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  reporterId    Int
  reporter      User @relation("IncidentReporter", fields: [reporterId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  subProcessId  String
  subProcess    SubProcess @relation(fields: [subProcessId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  subCategoryId String
  subCategory   SubCategory @relation(fields: [subCategoryId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  tasks         Task[]
  sites         Site[]   @relation("IncidentSites")
  assignedUsers User[]   @relation("IncidentAssignedUsers")
  attachments   Attachment[]

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  deletedAt     DateTime?

  @@index([userId])
  @@index([reporterId])
  @@index([subProcessId])
  @@index([subCategoryId])
}

model Task {
  id          String   @id @default(uuid())
  name        String
  description String?

  userId      Int
  user        User @relation(fields: [userId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  incidentId  String
  incident    Incident @relation(fields: [incidentId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  attachments Attachment[]

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  deletedAt   DateTime?

  @@index([userId])
  @@index([incidentId])
}

model Attachment {
  id         String   @id @default(uuid())
  fileName   String
  url        String

  incidentId String?
  incident   Incident? @relation(fields: [incidentId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  taskId     String?
  task       Task? @relation(fields: [taskId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  uploadedAt DateTime @default(now())

  @@index([incidentId])
  @@index([taskId])
}
