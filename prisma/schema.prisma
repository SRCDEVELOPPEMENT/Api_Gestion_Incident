generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlserver"
  url      = env("DATABASE_URL")
}

model User {
  id                   Int               @id @default(autoincrement())
  username             String            @unique
  passwordHash         String
  isActive             Boolean           @default(true)
  createdAt            DateTime          @default(now())
  deletedAt            DateTime?
  updatedAt            DateTime          @updatedAt
  siteId               Int?
  matricule            String?           @db.NVarChar(4000)
  email                String?           @db.NVarChar(4000)
  firstName            String?           @db.NVarChar(4000)
  lastName             String?           @db.NVarChar(4000)
  resetPasswordToken   String?           @db.NVarChar(4000)
  resetPasswordExpires DateTime?
  categories           Category[]
  reportedIncidents    Incident[]        @relation("IncidentReporter")
  createdIncidents     Incident[]        @relation("IncidentCreator")
  incidentComments     IncidentComment[]
  processes            Process[]
  refreshTokens        RefreshToken[]
  createdSites         Site[]            @relation("SiteCreator")
  subCategory          SubCategory[]
  subProcess           SubProcess[]
  tasks                Task[]
  typesCreated         Type[]            @relation("TypeCreatedBy")
  site                 Site?             @relation("UserSite", fields: [siteId], references: [id])
  roles                UserRole[]
}

model Role {
  id          Int              @id @default(autoincrement())
  name        String           @unique
  permissions RolePermission[]
  users       UserRole[]
}

model Permission {
  id    Int              @id @default(autoincrement())
  code  String           @unique
  roles RolePermission[]
}

model UserRole {
  userId Int
  roleId Int
  role   Role @relation(fields: [roleId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@id([userId, roleId])
}

model RolePermission {
  roleId       Int
  permissionId Int
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@id([roleId, permissionId])
}

model RefreshToken {
  id        Int      @id @default(autoincrement())
  tokenHash String   @unique
  userId    Int
  expiresAt DateTime
  revoked   Boolean  @default(false)
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([userId])
}

model Site {
  id                Int                    @id @default(autoincrement())
  name              String
  createdByUserId   Int
  createdAt         DateTime               @default(now())
  updatedAt         DateTime               @updatedAt
  deletedAt         DateTime?
  typeId            Int?
  impactedIncidents IncidentImpactedSite[]
  incidentSites     IncidentSite[]
  createdBy         User                   @relation("SiteCreator", fields: [createdByUserId], references: [id], onUpdate: NoAction)
  type              Type?                  @relation(fields: [typeId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  users             User[]                 @relation("UserSite")

  @@index([typeId])
}

model Type {
  id              Int       @id @default(autoincrement())
  name            String
  createdByUserId Int
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  deletedAt       DateTime?
  sites           Site[]
  createdBy       User      @relation("TypeCreatedBy", fields: [createdByUserId], references: [id], onUpdate: NoAction)
}

model Category {
  id            Int           @id @default(autoincrement())
  name          String
  userId        Int
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  deletedAt     DateTime?
  user          User          @relation(fields: [userId], references: [id], onUpdate: NoAction)
  incidents     Incident[]
  subCategories SubCategory[]
}

model SubCategory {
  id          Int        @id @default(autoincrement())
  name        String
  description String?
  categoryId  Int
  userId      Int
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  deletedAt   DateTime?
  incidents   Incident[]
  category    Category   @relation(fields: [categoryId], references: [id], onUpdate: NoAction)
  user        User       @relation(fields: [userId], references: [id], onUpdate: NoAction)

  @@index([categoryId])
}

model Process {
  id           Int          @id @default(autoincrement())
  name         String
  userId       Int
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  deletedAt    DateTime?
  incidents    Incident[]
  user         User         @relation(fields: [userId], references: [id], onUpdate: NoAction)
  subProcesses SubProcess[]
}

model SubProcess {
  id          Int        @id @default(autoincrement())
  name        String
  description String?
  processId   Int
  userId      Int
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  deletedAt   DateTime?
  incidents   Incident[]
  process     Process    @relation(fields: [processId], references: [id], onUpdate: NoAction)
  user        User       @relation(fields: [userId], references: [id], onUpdate: NoAction)

  @@index([processId])
}

model Incident {
  id                    Int                    @id @default(autoincrement())
  reference             String                 @unique
  description           String                 @db.NVarChar(Max)
  scope                 String
  status                String                 @default("OPEN")
  urgency               String
  criticality           String
  otherSubCategory      String?
  reporterName          String
  glpiTicketId          Int?
  dueDate               DateTime
  userId                Int
  reporterId            Int
  subProcessId          Int?
  categoryId            Int
  subCategoryId         Int?
  processDomainId       Int?
  rootCause             String?                 @db.NVarChar(Max)
  proposedSolution      String?                 @db.NVarChar(Max)
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt
  deletedAt             DateTime?
  takenInChargeAt       DateTime?
  resolvedAt            DateTime?
  attachments           Attachment[]
  category              Category               @relation(fields: [categoryId], references: [id])
  processDomain         Process?               @relation(fields: [processDomainId], references: [id])
  reporter              User                   @relation("IncidentReporter", fields: [reporterId], references: [id], onUpdate: NoAction)
  subCategory           SubCategory?           @relation(fields: [subCategoryId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  subProcess            SubProcess?            @relation(fields: [subProcessId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  user                  User                   @relation("IncidentCreator", fields: [userId], references: [id], onUpdate: NoAction)
  comments              IncidentComment[]
  incidentImpactedSites IncidentImpactedSite[]
  incidentPersonnes     IncidentPersonne[]
  incidentSites         IncidentSite[]
  tasks                 Task[]
  incidentGLPIUser             IncidentGLPIUser[]


  @@index([userId])
  @@index([reporterId])
  @@index([categoryId])
  @@index([subProcessId])
  @@index([subCategoryId])
  @@index([processDomainId])
}

model IncidentComment {
  id         Int      @id @default(autoincrement())
  incidentId Int
  userId     Int
  content    String
  createdAt  DateTime @default(now())
  incident   Incident @relation(fields: [incidentId], references: [id], onDelete: Cascade)
  user       User     @relation(fields: [userId], references: [id])
}

model Personne {
  id        Int                @id @default(autoincrement())
  fullname  String             @unique
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt
  deletedAt DateTime?
  incidents IncidentPersonne[]

  @@index([fullname])
}

model Task {
  id          Int          @id @default(autoincrement())
  name        String
  description String?
  status      String       @default("OPEN")
  dueDate     DateTime?
  userId      Int
  incidentId  Int
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  deletedAt   DateTime?
  attachments Attachment[]
  incident    Incident     @relation(fields: [incidentId], references: [id], onUpdate: NoAction)
  user        User         @relation(fields: [userId], references: [id], onUpdate: NoAction)

  @@index([userId])
  @@index([incidentId])
}

model Attachment {
  id         Int       @id @default(autoincrement())
  fileName   String
  url        String
  incidentId Int?
  taskId     Int?
  uploadedAt DateTime  @default(now())
  incident   Incident? @relation(fields: [incidentId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  task       Task?     @relation(fields: [taskId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([incidentId])
  @@index([taskId])
}

model IncidentSite {
  incidentId Int
  siteId     Int
  incident   Incident @relation(fields: [incidentId], references: [id], onDelete: Cascade)
  site       Site     @relation(fields: [siteId], references: [id], onDelete: Cascade)

  @@id([incidentId, siteId])
}

model IncidentImpactedSite {
  incidentId Int
  siteId     Int
  incident   Incident @relation(fields: [incidentId], references: [id], onDelete: Cascade)
  site       Site     @relation(fields: [siteId], references: [id], onDelete: Cascade)

  @@id([incidentId, siteId])
}

model IncidentPersonne {
  incidentId Int
  personneId Int
  assignedAt DateTime @default(now())
  incident   Incident @relation(fields: [incidentId], references: [id], onDelete: Cascade)
  personne   Personne @relation(fields: [personneId], references: [id], onDelete: Cascade)

  @@id([incidentId, personneId])
  @@index([personneId])
}

/// ================= INTÉGRATION GLPI =================
model GLPIUser {
  id                 Int      @id @default(autoincrement())
  glpiId             Int
  login              String?  @db.NVarChar(255)
  email              String?  @db.NVarChar(255)
  firstName          String?  @db.NVarChar(4000)
  lastName           String?  @db.NVarChar(4000)
  fullName           String?  @db.NVarChar(4000)
  phone              String?  @db.NVarChar(255)
  status             String   @default("ACTIVE") @db.NVarChar(100)
  isDeletedInSource  Boolean  @default(false)
  sourceUpdatedAt    DateTime?
  lastSyncedAt       DateTime?
  syncStatus         String   @default("SYNCED") @db.NVarChar(100)
  rawPayload         String?  @db.NVarChar(4000)
  incidentGLPIUser   IncidentGLPIUser[]

  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@unique([glpiId])
  @@index([email])
  @@index([login])
  @@index([status])
}

model GLPITicket {
  id                 Int      @id @default(autoincrement())
  glpiId             Int
  ticketNumber       String?  @db.NVarChar(255)
  title              String   @db.NVarChar(4000)
  description        String?  @db.NVarChar(4000)
  ticketType         String?  @db.NVarChar(100)
  status             String   @default("OPEN") @db.NVarChar(100)
  priority           String?  @db.NVarChar(100)
  urgency            String?  @db.NVarChar(100)
  impact             String?  @db.NVarChar(100)
  categoryName       String?  @db.NVarChar(4000)
  entityName         String?  @db.NVarChar(4000)
  locationName       String?  @db.NVarChar(4000)
  requesterName      String?  @db.NVarChar(4000)
  assigneeName       String?  @db.NVarChar(4000)
  openedAt           DateTime?
  dueAt              DateTime?
  resolvedAt         DateTime?
  closedAt           DateTime?
  sourceUpdatedAt    DateTime?
  lastSyncedAt       DateTime?
  syncStatus         String   @default("SYNCED") @db.NVarChar(100)
  rawPayload         String?  @db.NVarChar(4000)

  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@unique([glpiId])
  @@index([ticketNumber])
  @@index([status])
}

/// ================= RELATION INCIDENT - GLPIUSER =================
model IncidentGLPIUser {
  incidentId Int
  glpiUserId Int
  assignedAt DateTime @default(now())

  incident   Incident @relation(fields: [incidentId], references: [id], onDelete: Cascade)
  glpiUser   GLPIUser @relation(fields: [glpiUserId], references: [id], onDelete: Cascade)

  @@id([incidentId, glpiUserId])
  @@index([glpiUserId])
}
